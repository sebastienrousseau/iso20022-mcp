version: "0.0.11"
date-released: "2026-08-29"
license: "Apache-2.0 OR MIT"
repository-code: "https://github.com/sebastienrousseau/iso20022-mcp"
url: "https://iso20022-mcp.com"
keywords:
  - ISO 20022
  - payments
  - gateway
  - Model Context Protocol
  - MCP
  - AI agents
  - banking
